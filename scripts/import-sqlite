#!/usr/bin/env python3
"""Copy the SQLite catalogue into PostgreSQL (schema filecat of the shared database), then prove the copy is exact.
Adapted from jburnhams/database apps/planning/import-sqlite.

  scripts/import-sqlite                      ~/.local/share/filecat/catalog.db -> postgresql:///omarchy?options=-csearch_path%3Dfilecat
  scripts/import-sqlite --src F --dst URL    other source / target (trial runs use a throwaway database)
  scripts/import-sqlite --replace            empty the target tables first (default: refuse if not empty)
  scripts/import-sqlite --verify-only        compare only, copy nothing

The target schema comes from filecat's own migrations (filecat.db.connect migrates it first). Every table of the
source except SQLite/Alembic bookkeeping is copied, columns by name, in one transaction, parents first
(collections, then roots and sources, then files). Each id sequence is moved past the highest copied id.
The source is opened read-only; it may be the live catalogue, but pause filecat.timer first so it does not change.
Verification, per table: row count and a SHA-256 over every row in primary-key order, values compared as text
(floats by repr). Exit 0 only if every table matches.
"""
import argparse, hashlib, os, sqlite3, sys

import psycopg

ORDER_FIRST = ['collections', 'roots', 'sources']          # referenced by the later tables
BATCH = 5000


def q(c): return '"' + c.replace('"', '""') + '"'


def tables(src):
    names = [r[0] for r in src.execute("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' AND name <> 'alembic_version' ORDER BY name")]
    return sorted(names, key=lambda t: (ORDER_FIRST.index(t) if t in ORDER_FIRST else len(ORDER_FIRST), t))


def columns(src, t):
    info = src.execute(f'PRAGMA table_info({q(t)})').fetchall()      # cid, name, type, notnull, dflt, pk
    cols = [r[1] for r in info]
    pk = [r[1] for r in sorted((r for r in info if r[5]), key=lambda r: r[5])] or cols
    return cols, pk


def pg_types(dst, t):
    return dict(dst.execute("SELECT column_name, data_type FROM information_schema.columns WHERE table_schema = current_schema() AND table_name = %s", (t,)).fetchall())


def to_pg(row, kinds):
    """SQLite is loosely typed: give Postgres what each column expects (a number in a TEXT column becomes text)."""
    out = []
    for v, k in zip(row, kinds):
        if v is None: out.append(None)
        elif k in ('text', 'character varying') and not isinstance(v, str): out.append(str(v))
        else: out.append(v)
    return out


def digest(rows):
    h, n = hashlib.sha256(), 0
    for r in rows:
        h.update('\x1f'.join('\x00' if v is None else repr(float(v)) if isinstance(v, float) else str(v) for v in r).encode() + b'\x1e')
        n += 1
    return n, h.hexdigest()


def verify(src, dst):
    ok = True
    for t in tables(src):
        cols, pk = columns(src, t)
        sel = f'SELECT {", ".join(q(c) for c in cols)} FROM {q(t)} ORDER BY {", ".join(q(c) for c in pk)}'
        kinds = [pg_types(dst, t).get(c) for c in cols]
        a = digest(to_pg(r, kinds) for r in src.execute(sel))
        # SQLite orders text bytewise (BINARY); COLLATE "C" gives Postgres the same order
        rows_pg = dst.execute(f'SELECT {", ".join(q(c) for c in cols)} FROM {q(t)} ORDER BY ' +
                              ', '.join(f'{q(c)} COLLATE "C"' if kinds[cols.index(c)] in ('text', 'character varying') else q(c) for c in pk)).fetchall()
        b = digest(rows_pg)
        same = a == b; ok &= same
        print(f'{t:22} sqlite {a[0]:6} rows {a[1][:12]}   postgres {b[0]:6} rows {b[1][:12]}   {"same" if same else "DIFFERENT"}')
    return ok


class VerifyFailed(Exception): pass


def main():
    p = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    p.add_argument('--src', default=os.path.expanduser('~/.local/share/filecat/catalog.db'))
    p.add_argument('--dst', default='postgresql:///omarchy?options=-csearch_path%3Dfilecat')   # schema filecat of the shared database
    p.add_argument('--replace', action='store_true')
    p.add_argument('--verify-only', action='store_true')
    a = p.parse_args()
    src = sqlite3.connect(f'file:{a.src}?mode=ro', uri=True)
    from filecat.db import connect as filecat_connect                     # creates / migrates the target schema
    filecat_connect(a.dst).close()
    dst = psycopg.connect(a.dst)
    have_pg = {r[0] for r in dst.execute("SELECT table_name FROM information_schema.tables WHERE table_schema = current_schema()")}
    missing = [t for t in tables(src) if t not in have_pg]
    if missing: sys.exit(f'tables missing in {a.dst}: {missing}')
    if a.verify_only:
        ok = verify(src, dst); print('verified: identical' if ok else 'verification FAILED'); sys.exit(0 if ok else 1)
    # Copy and verify in ONE transaction: if the copy does not verify, it is rolled back and the target (including
    # anything --replace was about to delete) stays exactly as it was.
    try:
        with dst.transaction():
            for t in reversed(tables(src)):                       # children first when emptying
                n = dst.execute(f'SELECT count(*) FROM {q(t)}').fetchone()[0]
                if n and not a.replace: sys.exit(f'{t} already has {n} rows in {a.dst}; use --replace to overwrite')
                if n: dst.execute(f'DELETE FROM {q(t)}')
            for t in tables(src):
                cols, _ = columns(src, t)
                kinds = [pg_types(dst, t).get(c) for c in cols]
                ins = f'INSERT INTO {q(t)} ({", ".join(q(c) for c in cols)}) VALUES ({", ".join(["%s"] * len(cols))})'
                cur, n = src.execute(f'SELECT {", ".join(q(c) for c in cols)} FROM {q(t)}'), 0
                with dst.cursor() as w:
                    while batch := cur.fetchmany(BATCH):
                        w.executemany(ins, [to_pg(r, kinds) for r in batch]); n += len(batch)
                print(f'copied {t}: {n} rows')
            seqs = {t: 0 for t in tables(src)}                                # no AUTOINCREMENT in this catalogue: max(id) is the mark
            for t, seq in seqs.items():
                s = dst.execute("SELECT pg_get_serial_sequence(%s, 'id')", (t,)).fetchone()[0]
                if not s: continue
                top = max(seq, dst.execute(f'SELECT coalesce(max(id), 0) FROM {q(t)}').fetchone()[0])
                dst.execute('SELECT setval(%s, %s)', (s, top))
                print(f'sequence {t}.id -> {top}')
            if not verify(src, dst): raise VerifyFailed
    except VerifyFailed:
        sys.exit('verification FAILED: rolled back, nothing changed in the target')
    print('verified: identical'); dst.execute('ANALYZE'); dst.commit()


if __name__ == '__main__':
    main()
